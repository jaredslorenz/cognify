{
  "expo": {
    "name": "Cognify",
    "slug": "cognify-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "cognify",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1612"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cognify.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1612"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cognify.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cognify to access your camera to scan homework problems."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cognify to access your photos to upload homework problems."
        }
      ]
    ]
  }
}
